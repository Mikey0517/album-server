# 复制为 .env 后按需修改（docker compose 会自动读取 .env）
TZ=Asia/Shanghai

# 构建时 Alpine apk 镜像源。国内服务器建议阿里云；
# 海外服务器可改为 mirrors.aliyun.com 以外的地址，或留空使用官方 CDN。
APK_MIRROR=mirrors.aliyun.com

# 媒体与数据库根目录（容器内路径，通常不用改）
DATA_DIR=/data

# 单文件上传上限，字节。默认 500MB
MAX_UPLOAD_SIZE=524288000

# 登录 token 有效期（天）
TOKEN_DAYS=30

# CORS 白名单，逗号分隔；* 表示全部放行
ALLOWED_ORIGINS=*

# JVM 参数：小内存机器把 -Xmx 调到 256m；不要超过容器 memory limit
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseZGC
